{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:public": "npm run build && rm -f dist/sessions.json dist/weights.json dist/load.json && find dist/races -name '*.json' -not -name '*.min.json' -delete",
    "deploy": "npm run build:public && wrangler deploy"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "pinia": "^4.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.86.0"
  }
}
